<?xml version="1.0"?>
<package format="3">
  <name>kendra_robot</name>
  <version>0.1.0</version>
  <description>Safety-gated SO-ARM101 gateway and calibration</description>
  <maintainer email="noreply@users.noreply.github.com">Kendra robot contributors</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>moveit_py</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
